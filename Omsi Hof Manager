<script>
/* ================= LOGIC (Format nach OMSI-Wiki: Hofdatei) ================= */
const TAB='\t';
const pad2=n=>String(parseInt(n,10)||0).padStart(2,'0');
const clean=s=>String(s==null?'':s).replace(/[\t\r\n]+/g,' ');
const routeCode=r=>String(r.line||'').trim()+pad2(r.route);
const newState=()=>({name:'',servicetrip:'',gs:{announce:'',rollband:'',side:'',c900:'',c800:'',c500:''},scT:7,scB:4,termini:[],stops:[],routes:[],example:false});

function genHof(S,fmt){
  const L=[],nT=S.scT,nB=S.scB,g=S.gs;
  L.push('[name]',clean(S.name),'','[servicetrip]',clean(S.servicetrip),'');
  const codes=[g.c900,g.c800,g.c500];
  const gl=[g.announce,g.rollband,g.side];
  if(codes.some(c=>String(c).trim()!=='')) codes.forEach(c=>gl.push(String(c).trim()===''?'0':c));
  L.push('[global_strings]',String(gl.length),...gl.map(clean),'');
  L.push('stringcount_terminus',String(nT),'','stringcount_busstop',String(nB),'');
  const ts=(r,n)=>Array.from({length:n},(_,i)=>clean(r.strings[i]));
  if(fmt==='list'){
    L.push('[addterminus_list]');
    S.termini.forEach(r=>L.push((r.allexit?'{ALLEX}':'')+TAB+clean(r.code)+TAB+clean(r.name)+ts(r,nT).map(s=>TAB+s).join('')));
    L.push('[end]','','[addbusstop_list]');
    S.stops.forEach(r=>L.push(clean(r.name)+ts(r,nB).map(s=>TAB+s).join('')));
    L.push('[end]','');
  }else{
    S.termini.forEach(r=>{L.push(r.allexit?'[addterminus_allexit]':'[addterminus]',clean(r.code),clean(r.name),...ts(r,nT));});
    L.push('');
    S.stops.forEach(r=>{L.push('[addbusstop]',clean(r.name),...ts(r,nB));});
    L.push('');
  }
  S.routes.forEach(r=>{
    L.push('[infosystem_trip]',routeCode(r),clean(r.desc),clean(r.dest),clean(r.line),'','[infosystem_busstop_list]',String(r.stops.length),...r.stops.map(clean),'');
  });
  return L.join('\r\n');
}

function parseHof(text){
  const lines=text.replace(/^﻿/,'').split(/\r\n|\n|\r/);
  const R=newState(); let i=0,unknown=0,lastRoute=null;
  const nne=()=>{while(i<lines.length&&!lines[i].trim())i++;return i<lines.length?lines[i++].trim():'';};
  const raw=()=>i<lines.length?lines[i++]:'';
  const strs=n=>{const a=[];while(a.length<n&&i<lines.length&&!/^\[/.test(lines[i]))a.push(lines[i++]);while(a.length<n)a.push('');return a;};
  while(i<lines.length){
    const ln=lines[i++]; if(!ln||/^\s/.test(ln))continue;
    const l=ln.trim(),lo=l.toLowerCase(); let m;
    if(lo==='[name]')R.name=nne();
    else if(lo==='[servicetrip]')R.servicetrip=nne();
    else if(lo==='[global_strings]'){
      const n=parseInt(nne(),10)||0,a=[];for(let k=0;k<n;k++)a.push(raw().trim());
      const z=v=>(v==null||v==='0')?'':v;
      R.gs={announce:a[0]||'',rollband:a[1]||'',side:a[2]||'',c900:z(a[3]),c800:z(a[4]),c500:z(a[5])};
    }
    else if(m=/^\[?stringcount_(terminus|busstop)\]?\s*(\d+)?$/i.exec(l)){
      const v=m[2]!==undefined?+m[2]:(parseInt(nne(),10)||0);
      if(m[1].toLowerCase()==='terminus')R.scT=v;else R.scB=v;
    }
    else if(lo==='[addterminus]'||lo==='[addterminus_allexit]'){
      const code=nne(),name=nne();R.termini.push({allexit:lo.endsWith('allexit]'),code,name,strings:strs(R.scT)});
    }
    else if(lo==='[addbusstop]'){const name=nne();R.stops.push({name,strings:strs(R.scB)});}
    else if(lo==='[addterminus_list]'||lo==='[addbusstop_list]'){
      const term=lo==='[addterminus_list]';
      while(i<lines.length){
        const x=lines[i++]; if(/^\s*\[end\]/i.test(x))break; if(!x.trim())continue;
        const c=x.split('\t');
        if(term)R.termini.push({allexit:/allex/i.test(c[0]),code:(c[1]||'').trim(),name:(c[2]||'').trim(),strings:c.slice(3)});
        else R.stops.push({name:(c[0]||'').trim(),strings:c.slice(1)});
      }
    }
    else if(lo==='[infosystem_trip]'){
      const id=nne(),desc=raw(),dest=nne();nne();
      let j=i;while(j<lines.length&&!lines[j].trim())j++;
      if(j<lines.length&&!/^\[/.test(lines[j]))i=j+1;
      const idd=id.replace(/\D/g,'');
      lastRoute={line:idd.length>2?idd.slice(0,-2):'',route:idd.slice(-2),desc:desc.trim(),dest,stops:[]};
      R.routes.push(lastRoute);
    }
    else if(lo==='[infosystem_busstop_list]'){
      const n=parseInt(nne(),10)||0,a=[];for(let k=0;k<n;k++)a.push(nne());
      if(lastRoute)lastRoute.stops=a;
    }
    else if(/^\[/.test(l))unknown++;
  }
  R.termini.forEach(r=>{r.strings=r.strings.map(s=>s.replace(/\r$/,''));});
  R.unknown=unknown;
  return R;
}
const LIM_T={0:16,1:16,2:16,3:16,5:20,8:15,9:4,22:6};
const LIM_B={0:16,1:20,2:20,3:20};
function validate(S,tr){
  const out=[],add=(lvl,k,v)=>out.push({lvl,msg:tr(k,v)});
  if(!S.name.trim())add('err','vNoName');
  const st=S.termini.find(x=>x.name===S.servicetrip);
  if(!S.servicetrip.trim())add('warn','vNoService');
  else if(!st)add('err','vService',{n:S.servicetrip});
  else if(!st.allexit)add('warn','vServiceAllex',{n:S.servicetrip});
  const seen={};
  S.termini.forEach(r=>{
    const c=String(r.code).trim();
    if(!/^\d{1,4}$/.test(c))add('err','vCodeBad',{n:r.name||'?',c});
    else if(seen[c]!==undefined&&seen[c]!==r.name)add('err','vCodeDup',{c,a:seen[c],b:r.name});
    else seen[c]=r.name;
    if(!r.name.trim())add('err','vTermNoName',{c});
    for(const k in LIM_T){if(k<S.scT&&(r.strings[k]||'').length>LIM_T[k])add('warn','vLen',{n:r.name,s:k,m:LIM_T[k]});}
  });
  S.stops.forEach(r=>{for(const k in LIM_B){if(k<S.scB&&(r.strings[k]||'').length>LIM_B[k])add('warn','vLen',{n:r.name,s:k,m:LIM_B[k]});}});
  const stopNames=new Set(S.stops.map(x=>x.name));
  S.termini.filter(r=>!r.allexit&&r.name.trim()&&!stopNames.has(r.name)).forEach(r=>add('warn','vTermStop',{n:r.name}));
  const ids={};
  S.routes.forEach(r=>{
    const id=routeCode(r),lab=r.line+'/'+pad2(r.route);
    if(!r.line)add('err','vNoLine',{r:lab});
    if(ids[id])add('err','vRouteDup',{r:id});ids[id]=1;
    if(!S.termini.some(x=>String(x.code).trim()===String(r.dest).trim()))add('err','vDestMiss',{r:lab});
    if(r.stops.length<2)add('warn','vRouteShort',{r:lab});
    [...new Set(r.stops.filter(n=>!stopNames.has(n)))].forEach(n=>add('err','vStopMiss',{r:lab,n}));
  });
  return out;
}
