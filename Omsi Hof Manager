let lang=(()=>{try{const l=localStorage.getItem('hofw-lang');if(l&&I[l])return l}catch(e){}const n=(navigator.language||'de').slice(0,2);return I[n]?n:'de'})();
const tr=(k,v)=>{const d=(I[lang]&&I[lang][k]!=null)?I[lang][k]:(I.en[k]!=null?I.en[k]:k);return v?d.replace(/\{(\w+)\}/g,(_,x)=>v[x]==null?'':v[x]):d};
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const T=(k,v)=>esc(tr(k,v));
const $=s=>document.querySelector(s);

function example(){
  const S=newState();S.example=true;S.name='Beispielhof Neustadt';S.servicetrip='Betriebsfahrt';
  S.gs.announce='Neustadt';S.gs.rollband='Neustadt';S.gs.side='Neustadt';
  const T=(allexit,code,name,short)=>({allexit,code,name,strings:[short.toUpperCase().slice(0,16),name.slice(0,16),'',name.slice(0,16),'',name.slice(0,20),'']});
  S.termini=[T(true,'110','Betriebsfahrt','Betriebsfahrt'),T(false,'111','Bahnhof','Bahnhof'),T(false,'112','Hauptfriedhof','Hauptfriedhof'),T(false,'113','Industriepark','Industriepark')];
  const P=(n)=>({name:n,strings:[n.toUpperCase().slice(0,16),n,'',n]});
  S.stops=['Bahnhof','Marktplatz','Rathaus','Schulzentrum','Hauptfriedhof','Gewerbering','Industriepark'].map(P);
  S.routes=[
    {line:'2',route:'01',desc:'Bahnhof - Hauptfriedhof',dest:'112',stops:['Bahnhof','Marktplatz','Rathaus','Schulzentrum','Hauptfriedhof']},
    {line:'2',route:'02',desc:'Hauptfriedhof - Bahnhof',dest:'111',stops:['Hauptfriedhof','Schulzentrum','Rathaus','Marktplatz','Bahnhof']},
    {line:'7',route:'01',desc:'Bahnhof - Industriepark',dest:'113',stops:['Bahnhof','Marktplatz','Gewerbering','Industriepark']}];
  return S;
}
let S=(()=>{try{const j=JSON.parse(localStorage.getItem('hofw-state')||'null');if(j&&Array.isArray(j.termini))return Object.assign(newState(),j)}catch(e){}return example()})();
let tab='gen',selR=0,prevS=null,fmt='list',ib={v:'20100',dest:'',stop:0},saveT=null,flt={ter:'',stp:''};
function persist(){clearTimeout(saveT);saveT=setTimeout(()=>{try{localStorage.setItem('hofw-state',JSON.stringify(S))}catch(e){}},300)}
function dirty(){if(S.example){S.example=false;const b=$('#banner');if(b)b.remove()}persist();updBadge();}

/* ---------- Rendering ---------- */
const TABS=['gen','ter','stp','rte','ibis','file'];
const TK={gen:'tabGen',ter:'tabTer',stp:'tabStp',rte:'tabRte',ibis:'tabIbis',file:'tabFile'};
function renderTabs(){
  $('#tabs').innerHTML=TABS.map(k=>`<button role="tab" aria-selected="${k===tab}" data-act="tab" data-k="${k}">${T(TK[k])}${k==='file'?'<span id="bdg"></span>':''}</button>`).join('');
  $('#langLbl').textContent=tr('lang');updBadge();
}
function updBadge(){
  const el=$('#bdg');if(!el)return;
  const v=validate(S,tr);const e=v.filter(x=>x.lvl==='err').length;
  el.innerHTML=v.length?`<span class="badge ${e?'err':''}">${v.length}</span>`:'';
}
function render(){
  renderTabs();const v=$('#view');
  ({gen:rGen,ter:rTer,stp:rStp,rte:rRte,ibis:rIbis,file:rFile})[tab](v);
  if(S.example&&tab!=='file'){v.insertAdjacentHTML('afterbegin',`<div class="banner" id="banner"><span>${T('exampleBanner')}</span><button class="btn sm" data-act="clearEx">${T('clearEx')}</button></div>`)}
}
function fld(label,help,inner){return `<div class="field"><label>${label}</label>${inner}${help?`<small>${help}</small>`:''}</div>`}
function rGen(v){
