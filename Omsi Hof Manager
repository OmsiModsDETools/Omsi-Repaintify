function termRow(r,i){
  let h=`<tr data-i="${i}"><td class="s1"><button class="x" data-act="delT" data-i="${i}" title="${T('del')}" aria-label="${T('del')}">×</button></td>
  <td class="s2"><input type="checkbox" data-tf="allexit" data-i="${i}" ${r.allexit?'checked':''} title="${T('colAllex')}" aria-label="${T('colAllex')}"></td>
  <td class="s3"><input type="text" data-tf="code" data-i="${i}" value="${esc(r.code)}" inputmode="numeric" aria-label="${T('colCode')}"></td>
  <td class="s4"><input type="text" data-tf="name" data-i="${i}" value="${esc(r.name)}" aria-label="${T('colName')}"></td>`;
  for(let k=0;k<S.scT;k++){const val=r.strings[k]||'';h+=`<td><input type="text" data-ts="${k}" data-i="${i}" value="${esc(val)}" class="${LIM_T[k]&&val.length>LIM_T[k]?'over':''}"></td>`}
  return h+'</tr>';
}
function rTer(v){
