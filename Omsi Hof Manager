   ${fld(T('fSide'),T('fSideH'),`<input type="text" data-gs="side" value="${esc(g.side)}">`)}
   ${fld(T('c9'),T('cH'),`<input type="text" data-gs="c900" inputmode="numeric" value="${esc(g.c900)}">`)}
   ${fld(T('c8'),'',`<input type="text" data-gs="c800" inputmode="numeric" value="${esc(g.c800)}">`)}
   ${fld(T('c5'),'',`<input type="text" data-gs="c500" inputmode="numeric" value="${esc(g.c500)}">`)}
  </div></div>
  <div class="card"><h3>${T('counts')}</h3><div class="row" style="align-items:flex-end">
   ${fld(T('scT'),'',`<input type="number" min="1" max="999" data-g="scT" value="${S.scT}">`)}
   ${fld(T('scB'),'',`<input type="number" min="1" max="999" data-g="scB" value="${S.scB}">`)}
   <button class="btn" data-act="preset" data-p="7,4">${T('presetStd')}</button><button class="btn" data-act="preset" data-p="26,9">${T('presetUni')}</button>
  </div><p class="hint" style="margin:10px 0 0">${T('scH')}</p></div>
  <datalist id="dl-ter">${S.termini.map(r=>`<option value="${esc(r.name)}">`).join('')}</datalist>`;
