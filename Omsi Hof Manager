  v.innerHTML=`<h2>${T('ter_title')}</h2><p class="intro">${T('ter_intro')}</p>
  <div class="row" style="margin-bottom:10px"><button class="btn primary" data-act="addT">${T('add')}</button><button class="btn" data-act="fillT">${T('fillT')}</button>
   <input type="text" id="flt" data-flt="ter" placeholder="${T('filter')}" value="${esc(flt.ter)}" style="max-width:220px;margin-left:auto"></div>
  <div class="gridwrap"><table class="g"><thead><tr><th class="s1"></th><th class="s2" title="${T('colAllex')}">⛔</th><th class="s3">${T('colCode')}</th><th class="s4">${T('colName')}</th>${th}</tr></thead>
  <tbody id="tb">${S.termini.map(termRow).join('')}</tbody></table></div>`;
  applyFlt('ter');
}
function stopRow(r,i){
  let h=`<tr data-i="${i}"><td class="s1"><button class="x" data-act="delS" data-i="${i}" title="${T('del')}" aria-label="${T('del')}">×</button></td>
  <td class="s2"><input type="text" data-sf="name" data-i="${i}" value="${esc(r.name)}" aria-label="${T('colStop')}"></td>`;
  for(let k=0;k<S.scB;k++){const val=r.strings[k]||'';h+=`<td><input type="text" data-ss="${k}" data-i="${i}" value="${esc(val)}" class="${LIM_B[k]&&val.length>LIM_B[k]?'over':''}"></td>`}
  return h+'</tr>';
}
function rStp(v){
  let th='';for(let k=0;k<S.scB;k++)th+=`<th>S${k}<small>${esc(LBL_B[k]||'')}</small></th>`;
  v.innerHTML=`<h2>${T('stp_title')}</h2><p class="intro">${T('stp_intro')}</p>
  <div class="row" style="margin-bottom:10px"><button class="btn primary" data-act="addS">${T('add')}</button><button class="btn" data-act="fillS">${T('fillT')}</button>
   <input type="text" id="flt" data-flt="stp" placeholder="${T('filter')}" value="${esc(flt.stp)}" style="max-width:220px;margin-left:auto"></div>
  <div class="gridwrap"><table class="g st"><thead><tr><th class="s1"></th><th class="s2">${T('colStop')}</th>${th}</tr></thead>
  <tbody id="tb">${S.stops.map(stopRow).join('')}</tbody></table></div>`;
  applyFlt('stp');
}
function applyFlt(k){
  const q=flt[k].toLowerCase();
  document.querySelectorAll('#tb tr').forEach(tr=>{const i=+tr.dataset.i;const n=((k==='ter'?S.termini[i]:S.stops[i])||{}).name||'';tr.hidden=!!q&&!n.toLowerCase().includes(q)});
}
function destName(code){const t=S.termini.find(x=>String(x.code).trim()===String(code).trim());return t?t.name:''}
function rlistHtml(){
  if(!S.routes.length)return `<p class="hint">${T('noRoutes')}</p>`;
  return S.routes.map((r,i)=>`<button data-act="selR" data-i="${i}" aria-current="${i===selR}"><span class="ln">${esc(r.line||'?')}</span><span><span class="rn">${esc(routeCode(r))}</span><br>${esc(destName(r.dest)||r.desc||'–')}</span></button>`).join('');
}
function rteEditor(){
  const r=S.routes[selR];if(!r)return '';
  const names=new Set(S.stops.map(x=>x.name));
  return `<div class="card"><div class="grid">
   ${fld(T('line'),'',`<input type="text" data-rf="line" value="${esc(r.line)}" inputmode="numeric">`)}
   ${fld(T('routeNo'),'',`<input type="text" data-rf="route" value="${esc(r.route)}" inputmode="numeric">`)}
   ${fld(T('desc'),'',`<input type="text" data-rf="desc" value="${esc(r.desc)}">`)}
   ${fld(T('dest'),'',`<select data-rf="dest"><option value="">${T('destNone')}</option>${S.termini.filter(x=>!x.allexit).map(x=>`<option value="${esc(x.code)}" ${String(x.code).trim()===String(r.dest).trim()?'selected':''}>${esc(x.name)} (${esc(x.code)})</option>`).join('')}</select>`)}
  </div><p class="hint" style="margin:10px 0 0">${T('ibisInput')}: <code id="rcode">${esc(routeCode(r))}</code></p></div>
  <div class="card"><h3>${T('stopsList')} · ${r.stops.length}</h3><div id="rs">${r.stops.map((n,k)=>`<div class="srow"><span class="no">${k+1}</span><input type="text" list="dl-stops" data-rs="${k}" value="${esc(n)}" class="${names.has(n)?'':'miss'}"><span class="acts"><button class="x" data-act="upRS" data-k="${k}" title="${T('up')}" aria-label="${T('up')}">↑</button><button class="x" data-act="dnRS" data-k="${k}" title="${T('down')}" aria-label="${T('down')}">↓</button><button class="x" data-act="delRS" data-k="${k}" title="${T('remove')}" aria-label="${T('remove')}">×</button></span></div>`).join('')}</div>
   <div class="row" style="margin-top:8px"><button class="btn" data-act="addRS">${T('addStop')}</button></div>
   <div class="field" style="margin-top:14px"><label>${T('pasteLabel')}</label><textarea id="paste" rows="4"></textarea><div class="row"><button class="btn" data-act="pasteRS">${T('pasteBtn')}</button></div></div>
  </div>
  <div class="row"><button class="btn" data-act="rev">${T('reverse')}</button><button class="btn danger" data-act="delR">${T('delRoute')}</button></div>
  <datalist id="dl-stops">${S.stops.map(x=>`<option value="${esc(x.name)}">`).join('')}</datalist>`;
}
function rRte(v){
  if(selR>=S.routes.length)selR=Math.max(0,S.routes.length-1);
  v.innerHTML=`<h2>${T('rte_title')}</h2><p class="intro">${T('rte_intro')}</p>
  <div class="split"><div><button class="btn primary" data-act="newR" style="width:100%;margin-bottom:8px">${T('newRoute')}</button><div class="rlist" id="rlist">${rlistHtml()}</div></div><div id="reditor">${rteEditor()}</div></div>`;
}
const center=(s,n)=>{s=String(s||'').slice(0,n);const p=Math.floor((n-s.length)/2);return ' '.repeat(Math.max(0,p))+s};
function rIbis(v){
  v.innerHTML=`<h2>${T('ibis_title')}</h2><p class="intro">${T('ibis_intro')}</p>
  <div class="card"><div class="row">${fld(T('ibisIn'),'',`<input type="text" id="ibv" data-ib="v" inputmode="numeric" value="${esc(ib.v)}" style="width:150px;font:500 20px var(--f-mono)">`)}
  ${fld(T('destIn'),'',`<input type="text" id="ibd" data-ib="dest" inputmode="numeric" value="${esc(ib.dest)}" style="width:150px;font:500 20px var(--f-mono)">`)}</div></div>
  <div id="ibisOut"></div>`;
  updIbis();
}
function updIbis(){
  const out=$('#ibisOut');if(!out)return;
  const v=ib.v.replace(/\D/g,'').replace(/^0+/,'');
  const r=v.length>=3?S.routes.find(x=>routeCode(x).replace(/^0+/,'')===v):null;
  const tcode=(ib.dest.trim()||(r?r.dest:'')).trim();
  const t=tcode?S.termini.find(x=>String(x.code).trim()===tcode):null;
  const st=k=>(t&&t.strings[k])||'';
  let h='';
  h+=`<p class="hint">${r?`${T('routeFound')}: ${esc(routeCode(r))}${r.desc?' · '+esc(r.desc):''}`:T('noMatch')}</p>`;
  if(tcode&&!t)h+=`<p class="hint" style="color:var(--err)">${T('unknownDest')}: ${esc(tcode)}</p>`;
  h+=`<div class="led"><div><div class="lbl">${T('front')}</div><div class="mx"><div class="lnum">${esc(r?r.line:'')}</div><pre>${esc(center(st(1),16))}\n${esc(center(st(2),16))}</pre></div>
   <div class="lbl" style="margin-top:10px">${T('front')} (S3)</div><pre class="lcd" style="margin:0">${esc(st(3))||'&nbsp;'}</pre></div>
   <div class="cols2"><div><div class="lbl">${T('ibis1')} (S0)</div><div class="lcd">${esc(st(0))||'&nbsp;'}</div></div><div><div class="lbl">${T('ibis2')} (S5)</div><div class="lcd">${esc(st(5))||'&nbsp;'}</div></div><div><div class="lbl">${T('roll')} (S4)</div><div class="lcd">${esc(st(4))||'&nbsp;'}</div></div></div></div>`;
  if(r){
    if(!r.stops.length)h+=`<p class="hint">${T('noStops')}</p>`;
    else{
      ib.stop=Math.max(0,Math.min(ib.stop,r.stops.length-1));
      const sn=r.stops[ib.stop],sp=S.stops.find(x=>x.name===sn),ss=k=>(sp&&sp.strings[k])||'';
      h+=`<div class="led" style="margin-top:14px"><div class="row" style="justify-content:space-between"><div class="lbl" style="margin:0">${T('stopNow')} ${ib.stop+1}/${r.stops.length}</div>
      <span class="row"><button class="btn sm" data-act="ibPrev">${T('prev')}</button><button class="btn sm" data-act="ibNext">${T('next')}</button></span></div>
      <div class="cols2"><div><div class="lbl">${T('ibis1')} (S0)</div><div class="lcd">${esc(ss(0))||'&nbsp;'}</div></div><div><div class="lbl">${T('ibis2')} (S3)</div><div class="lcd">${esc(ss(3))||'&nbsp;'}</div></div>
      <div><div class="lbl">${T('interior')} (S1 / S2)</div><div class="lcd">${esc(ss(1))||'&nbsp;'}\n${esc(ss(2))}</div></div></div></div>`;
    }
  }
  out.innerHTML=h;
}
function rFile(v){
  v.innerHTML=`<h2>${T('file_title')}</h2>
  <div class="card"><div class="row" style="justify-content:space-between;margin-bottom:10px"><label class="row" style="gap:8px">${T('fmt')}
   <select id="fmt" style="width:auto"><option value="list" ${fmt==='list'?'selected':''}>${T('fmt2')}</option><option value="lines" ${fmt==='lines'?'selected':''}>${T('fmt1')}</option></select></label>
   <button class="btn primary" data-act="copy" id="cpy">${T('copy')}</button></div>
   <textarea id="out" rows="14" readonly spellcheck="false" style="white-space:pre;overflow:auto"></textarea>
   <p class="hint" style="margin:10px 0 0">${T('saveHint')}</p></div>
  <div class="card"><h3>${T('problems')}</h3><ul class="chk" id="chk"></ul></div>
  <div class="card"><h3>${T('importT')}</h3><p class="hint" style="margin-top:0">${T('importHint')}</p>
   <div class="row" style="margin-bottom:8px"><label class="btn" for="pick" style="display:inline-block">${T('pickFile')}</label><input type="file" id="pick" accept=".hof,.txt" hidden></div>
   <textarea id="imp" rows="6" spellcheck="false"></textarea>
   <div class="row" style="margin-top:8px"><button class="btn primary" data-act="doImport">${T('applyImport')}</button><button class="btn" data-act="undo" ${prevS?'':'disabled'}>${T('undo')}</button><span class="hint" id="impmsg"></span></div></div>
  <div class="row"><button class="btn danger" data-act="newEmpty">${T('newEmpty')}</button></div>`;
  fillFile();
}
function fillFile(){
  const o=$('#out');if(o)o.value=genHof(S,fmt);
  const c=$('#chk');if(!c)return;const v=validate(S,tr);
  c.innerHTML=v.length?v.slice(0,40).map(x=>`<li class="${x.lvl}">${esc(x.msg)}</li>`).join(''):`<li class="ok">${T('noProblems')}</li>`;
}

/* ---------- Eingaben ---------- */
const pad=(a,n)=>{while(a.length<n)a.push('');return a};
function onInput(e){
  const el=e.target,d=el.dataset;if(!el.matches('input,select,textarea'))return;
  const val=el.type==='checkbox'?el.checked:el.value;
  if(d.flt){flt[d.flt]=val;applyFlt(d.flt);return}
  if(d.ib){ib[d.ib]=val;if(d.ib==='v')ib.stop=0;updIbis();return}
  if(el.id==='fmt'){fmt=val;fillFile();return}
  if(d.g){if(d.g==='scT'||d.g==='scB'){S[d.g]=Math.max(1,Math.min(999,parseInt(val,10)||1))}else S[d.g]=val;
    if(d.g==='name'||d.g==='servicetrip'){}dirty();return}
  if(d.gs){S.gs[d.gs]=val;dirty();return}
  if(d.tf!==undefined){const r=S.termini[+d.i];r[d.tf]=val;if(d.tf==='allexit'||d.tf==='name')persistRefresh();dirty();return}
  if(d.ts!==undefined){const r=S.termini[+d.i];pad(r.strings,+d.ts+1)[+d.ts]=val;el.classList.toggle('over',!!LIM_T[d.ts]&&val.length>LIM_T[d.ts]);dirty();return}
  if(d.sf!==undefined){S.stops[+d.i].name=val;dirty();return}
  if(d.ss!==undefined){const r=S.stops[+d.i];pad(r.strings,+d.ss+1)[+d.ss]=val;el.classList.toggle('over',!!LIM_B[d.ss]&&val.length>LIM_B[d.ss]);dirty();return}
  if(d.rf){const r=S.routes[selR];r[d.rf]=val;const rc=$('#rcode');if(rc)rc.textContent=routeCode(r);const rl=$('#rlist');if(rl)rl.innerHTML=rlistHtml();dirty();return}
  if(d.rs!==undefined){const r=S.routes[selR];r.stops[+d.rs]=val;const names=new Set(S.stops.map(x=>x.name));el.classList.toggle('miss',!names.has(val));dirty();return}
}
function persistRefresh(){}
document.addEventListener('input',onInput);
document.addEventListener('change',e=>{if(e.target.matches('select'))onInput(e)});
const armed=(el,fn)=>{if(el.dataset.armed){fn();return}el.dataset.armed='1';const o=el.textContent;el.textContent=tr('sure');setTimeout(()=>{if(el.isConnected){el.textContent=o;delete el.dataset.armed}},3000)};
function lastTbFocus(sel){const rows=document.querySelectorAll('#tb tr');const l=rows[rows.length-1];if(l){const i=l.querySelector(sel);if(i){i.focus();l.scrollIntoView({block:'nearest'})}}}
const UM={'ä':'AE','ö':'OE','ü':'UE','ß':'SS','Ä':'AE','Ö':'OE','Ü':'UE'};
const up16=s=>s.replace(/[äöüßÄÖÜ]/g,c=>UM[c]).toUpperCase().slice(0,16);
function copyText(){
  const ta=$('#out'),b=$('#cpy');
  const done=ok=>{b.textContent=ok?tr('copied'):tr('copyFail');setTimeout(()=>{b.textContent=tr('copy')},2200)};
  const fb=()=>{ta.focus();ta.select();let ok=false;try{ok=document.execCommand('copy')}catch(e){}done(ok)};
  try{navigator.clipboard.writeText(ta.value).then(()=>done(true),fb)}catch(e){fb()}
}
function doImport(){
  const txt=$('#imp').value;if(!txt.trim())return;
  prevS=JSON.parse(JSON.stringify(S));
  const R=parseHof(txt);R.example=false;S=R;persist();
  render();$('#impmsg').textContent=tr('imported',{a:S.termini.length,b:S.stops.length,c:S.routes.length});
}
document.addEventListener('click',e=>{
  const b=e.target.closest('[data-act]');if(!b)return;const d=b.dataset,a=d.act;
  switch(a){
    case 'tab':tab=d.k;render();return;
    case 'clearEx':prevS=null;S=newState();persist();render();return;
    case 'preset':{const[p,q]=d.p.split(',').map(Number);S.scT=p;S.scB=q;dirty();render();return}
    case 'addT':S.termini.push({allexit:false,code:String(Math.max(100,...S.termini.map(x=>parseInt(x.code,10)||0))+1),name:'',strings:[]});dirty();rTer($('#view'));lastTbFocus('[data-tf="name"]');return;
    case 'delT':S.termini.splice(+d.i,1);dirty();rTer($('#view'));return;
    case 'fillT':S.termini.forEach(r=>{const n=r.name;if(!n)return;const set=(i,v)=>{if(i<S.scT&&!(r.strings[i]||'').trim())pad(r.strings,i+1)[i]=v};set(0,up16(n));set(1,n.slice(0,16));set(3,n.slice(0,16));set(5,n.slice(0,20));set(8,n.slice(0,15))});dirty();rTer($('#view'));return;
    case 'addS':S.stops.push({name:'',strings:[]});dirty();rStp($('#view'));{const rows=document.querySelectorAll('#tb tr');const l=rows[rows.length-1];if(l)l.querySelector('input').focus()}return;
    case 'delS':S.stops.splice(+d.i,1);dirty();rStp($('#view'));return;
    case 'fillS':S.stops.forEach(r=>{const n=r.name;if(!n)return;const set=(i,v)=>{if(i<S.scB&&!(r.strings[i]||'').trim())pad(r.strings,i+1)[i]=v};set(0,up16(n));set(1,n.slice(0,20));set(3,n.slice(0,20))});dirty();rStp($('#view'));return;
    case 'selR':selR=+d.i;rRte($('#view'));return;
    case 'newR':{const l=S.routes[S.routes.length-1];S.routes.push({line:l?l.line:'1',route:pad2(S.routes.filter(x=>l&&x.line===l.line).length+1),desc:'',dest:'',stops:[]});selR=S.routes.length-1;dirty();rRte($('#view'));return}
    case 'delR':S.routes.splice(selR,1);dirty();rRte($('#view'));return;
    case 'addRS':S.routes[selR].stops.push('');dirty();rRte($('#view'));{const ins=document.querySelectorAll('#rs input');if(ins.length)ins[ins.length-1].focus()}return;
    case 'delRS':S.routes[selR].stops.splice(+d.k,1);dirty();rRte($('#view'));return;
    case 'upRS':case 'dnRS':{const s=S.routes[selR].stops,k=+d.k,j=a==='upRS'?k-1:k+1;if(j<0||j>=s.length)return;[s[k],s[j]]=[s[j],s[k]];dirty();rRte($('#view'));return}
    case 'pasteRS':{const n=$('#paste').value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);if(!n.length)return;S.routes[selR].stops.push(...n);dirty();rRte($('#view'));return}
    case 'rev':{const r=S.routes[selR];let no=parseInt(r.route,10)||0;const ids=new Set(S.routes.map(routeCode));let nr;do{no++;nr=pad2(no)}while(ids.has(r.line+nr));
      const first=r.stops[0],t=S.termini.find(x=>!x.allexit&&x.name===first);
      const parts=r.desc.split(' - ');S.routes.splice(selR+1,0,{line:r.line,route:nr,desc:parts.length>1?parts.reverse().join(' - '):r.desc,dest:t?t.code:'',stops:r.stops.slice().reverse()});selR++;dirty();rRte($('#view'));return}
    case 'ibPrev':ib.stop--;updIbis();return;
    case 'ibNext':ib.stop++;updIbis();return;
    case 'copy':copyText();return;
    case 'doImport':doImport();return;
    case 'undo':if(prevS){S=prevS;prevS=null;persist();render()}return;
    case 'newEmpty':armed(b,()=>{prevS=JSON.parse(JSON.stringify(S));S=newState();selR=0;persist();render()});return;
  }
});
document.addEventListener('change',e=>{
  if(e.target.id==='pick'&&e.target.files[0]){
    const fr=new FileReader();fr.onload=()=>{$('#imp').value=fr.result;doImport()};fr.readAsText(e.target.files[0],'windows-1252');
  }
});
/* Sprache */
(function(){const s=$('#lang');s.innerHTML=LANGS.map(([k,n])=>`<option value="${k}" ${k===lang?'selected':''}>${n}</option>`).join('');
  s.addEventListener('change',()=>{lang=s.value;try{localStorage.setItem('hofw-lang',lang)}catch(e){}document.documentElement.lang=lang;render()});document.documentElement.lang=lang})();
render();
</script>

